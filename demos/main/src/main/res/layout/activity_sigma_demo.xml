<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#12121A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SigmaDRM Premium Demo"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <!-- Player Section -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="#1E1E2A"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Player Configuration"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/text_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toStartOf="@id/btn_reset"
                        android:text="00:00 / 00:00"
                        android:textColor="#AAAAAA"
                        android:layout_marginEnd="8dp"/>
                    <Button
                        android:id="@+id/btn_reset"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_alignParentEnd="true"
                        android:background="#3D2B2B"
                        android:text="Reset App"
                        android:textAllCaps="false"
                        android:textColor="#FF6B6B"
                        android:textSize="10sp"/>
                </RelativeLayout>

                <androidx.media3.ui.PlayerView
                    android:id="@+id/player_view"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:background="#000000"
                    app:use_controller="false"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <Button android:id="@+id/btn_play"
                            android:layout_width="100dp" android:layout_height="40dp"
                            android:text="▶ Play" android:textSize="10sp"
                            android:backgroundTint="#2D5A43" android:layout_margin="4dp"
                            android:focusable="true"/>
                        <Button android:id="@+id/btn_pause"
                            android:layout_width="100dp" android:layout_height="40dp"
                            android:text="⏸ Pause" android:textSize="10sp"
                            android:backgroundTint="#5A4E2D" android:layout_margin="4dp"
                            android:focusable="true"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">
                        <Button android:id="@+id/btn_seek_back"
                            android:layout_width="90dp" android:layout_height="40dp"
                            android:text="⏪ Seek -10s" android:textSize="9sp"
                            android:backgroundTint="#2D435A" android:layout_margin="2dp"
                            android:focusable="true"/>
                        <Button android:id="@+id/btn_seek_forward"
                            android:layout_width="90dp" android:layout_height="40dp"
                            android:text="⏩ Seek +10s" android:textSize="9sp"
                            android:backgroundTint="#2D435A" android:layout_margin="2dp"
                            android:focusable="true"/>
                        <Button android:id="@+id/btn_mute"
                            android:layout_width="90dp" android:layout_height="40dp"
                            android:text="🔊 Bật âm" android:textSize="9sp"
                            android:backgroundTint="#2D5A5A" android:layout_margin="2dp"
                            android:focusable="true"/>
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btn_start"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#5E5CE6"
                    android:text="Start"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:focusable="true"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Config Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Manifest URI" android:textColor="#888888" android:textSize="12sp"/>
            <EditText android:id="@+id/edit_manifest_uri" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="https://sdrm-test.gviet.vn:9080/drm/static/vod_staging/the_box/manifest.mpd" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:textSize="14sp" android:inputType="textUri"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Base URL" android:textColor="#888888" android:textSize="12sp" android:layout_marginTop="8dp"/>
            <EditText android:id="@+id/edit_base_url" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="https://license-staging.sigmadrm.com/license/verify/widevine" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:textSize="14sp" android:inputType="textUri"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Merchant Id" android:textColor="#888888" android:textSize="12sp"/>
                    <EditText android:id="@+id/edit_merchant_id" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="sctv" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:textSize="14sp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="8dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="App Id" android:textColor="#888888" android:textSize="12sp"/>
                    <EditText android:id="@+id/edit_app_id" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="RedTV" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="User Id" android:textColor="#888888" android:textSize="12sp"/>
                    <EditText android:id="@+id/edit_user_id" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="U_Pnh_And" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:textSize="14sp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="8dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Session Id" android:textColor="#888888" android:textSize="12sp"/>
                    <EditText android:id="@+id/edit_session_id" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="S_Pnh_And" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Logs Section -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Logs"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_centerVertical="true"/>
            <Button
                android:id="@+id/btn_clear_logs"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:background="#2B2B3D"
                android:text="Clear Logs"
                android:textAllCaps="false"
                android:textColor="#AAAAAA"
                android:textSize="10sp"/>
        </RelativeLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            app:cardCornerRadius="8dp"
            app:cardBackgroundColor="#1A1A24">
            <TextView
                android:id="@+id/text_logs"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:text="Welcome to SigmaDRM Demo...\n"
                android:textColor="#00FF00"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:scrollbars="vertical"/>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
